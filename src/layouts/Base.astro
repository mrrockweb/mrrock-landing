---
import type { ComponentProps } from 'astro/types';
import Seo from '../components/Seo.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { company, contact, content, type Lang } from '../i18n/content';
import '../styles/global.css';

type Props = ComponentProps<typeof Seo> & {
  lang?: Lang;
  /** Header starts transparent over a full-bleed hero. */
  overlayHeader?: boolean;
};

const { lang = 'hu', overlayHeader = false, ...seo } = Astro.props;
const t = content[lang];
const home = t.ui.home;
const year = new Date().getFullYear();
const navHref = (id: string) => `${home}#${id}`;
---

<!doctype html>
<html lang={lang} class={overlayHeader ? 'has-overlay' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <Seo {...seo} />
    <link rel="alternate" hreflang="hu" href={new URL('/', Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />
  </head>
  <body>
    <a href="#main" class="skip">
      {t.ui.skip}
    </a>

    <header class="site-header" data-header>
      <div class="container site-header__inner">
        <a
          href={home}
          class="site-header__brand"
          aria-label={`${company.shortName} – ${lang === 'en' ? 'home' : 'főoldal'}`}
        >
          <Logo />
        </a>

        <nav class="site-nav" aria-label={t.ui.navLabel}>
          <ul class="site-nav__list" id="site-menu">
            {t.nav.map((item) => (
              <li>
                <a href={navHref(item.id)}>{item.label}</a>
              </li>
            ))}
            <li class="site-nav__lang">
              <a href={t.ui.langSwitch.href} hreflang={t.ui.langSwitch.lang} lang={t.ui.langSwitch.lang}>
                {t.ui.langSwitch.label}
              </a>
            </li>
          </ul>
        </nav>

        <div class="site-header__actions">
          <a
            class="site-header__lang"
            href={t.ui.langSwitch.href}
            hreflang={t.ui.langSwitch.lang}
            lang={t.ui.langSwitch.lang}
            aria-label={t.ui.langSwitch.label}
          >
            {t.ui.langSwitch.short}
          </a>
          <a class="btn btn--primary site-header__cta" href={navHref(t.contactSection.id)}>
            {t.hero.contactTitle}
          </a>
          <button
            class="site-header__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-menu"
            data-menu-toggle
            data-label-open={lang === 'en' ? 'Open menu' : 'Menü megnyitása'}
            data-label-close={lang === 'en' ? 'Close menu' : 'Menü bezárása'}
            aria-label={lang === 'en' ? 'Open menu' : 'Menü megnyitása'}
          >
            <span class="toggle-open">
              <Icon name="menu" size={26} />
            </span>
            <span class="toggle-close">
              <Icon name="close" size={26} />
            </span>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__grid">
        <div class="site-footer__brand">
          <Logo />
          <p>{t.services.intro}</p>
        </div>
        <nav aria-label={lang === 'en' ? 'Footer' : 'Lábléc'}>
          <h2 class="site-footer__title">{lang === 'en' ? 'Navigation' : 'Navigáció'}</h2>
          <ul>
            {t.nav.map((item) => (
              <li>
                <a href={navHref(item.id)}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div>
          <h2 class="site-footer__title">{lang === 'en' ? 'Contact' : 'Kapcsolat'}</h2>
          <ul>
            <li>
              <a class="tnum" href={contact.phoneHref}>
                {contact.phoneDisplay}
              </a>
            </li>
            <li>
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </li>
            <li>{contact.address}</li>
          </ul>
        </div>
        <div>
          <h2 class="site-footer__title">{lang === 'en' ? 'Company details' : 'Cégadatok'}</h2>
          <ul class="tnum">
            <li>{company.legalName}</li>
            <li>
              {t.footer.taxLabel}: {company.taxNumber}
            </li>
            <li>
              {t.footer.registryLabel}: {company.registry}
            </li>
          </ul>
        </div>
      </div>
      <div class="container site-footer__bottom">
        <p>
          © {year} {company.shortName}
        </p>
        <a href={t.ui.langSwitch.href} hreflang={t.ui.langSwitch.lang} lang={t.ui.langSwitch.lang}>
          {t.ui.langSwitch.label}
        </a>
      </div>
    </footer>

    <script>
      const header = document.querySelector<HTMLElement>('[data-header]');
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const root = document.documentElement;

      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const setMenu = (open: boolean) => {
        if (!toggle) return;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute(
          'aria-label',
          (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '',
        );
        root.classList.toggle('menu-open', open);
      };
      toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
      document
        .querySelectorAll('#site-menu a')
        .forEach((a) => a.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && root.classList.contains('menu-open')) {
          setMenu(false);
          toggle?.focus();
        }
      });
      window.matchMedia('(min-width: 961px)').addEventListener('change', (e) => e.matches && setMenu(false));
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -5rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    text-decoration: none;
  }
  .skip:focus {
    top: 1rem;
  }

  /* ---------- Header ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: var(--bg);
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    transition:
      background-color 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out),
      color 0.35s var(--ease-out);
  }
  /* Over the hero: transparent with light text until the page scrolls. */
  :global(.js.has-overlay) .site-header {
    position: fixed;
    inset: 0 0 auto;
    background: transparent;
    border-color: transparent;
    color: #ffffff;
  }
  :global(.js.has-overlay) .site-header.is-scrolled,
  :global(.js.has-overlay.menu-open) .site-header {
    background: var(--bg);
    border-color: var(--line);
    color: var(--ink);
    box-shadow: var(--shadow-1);
  }
  .site-header.is-scrolled {
    box-shadow: var(--shadow-1);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 100%;
  }
  .site-header__brand {
    flex: none;
    color: inherit;
    text-decoration: none;
  }
  .site-nav {
    margin-left: auto;
  }
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.4vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav__list a {
    position: relative;
    display: inline-block;
    padding: 0.5rem 0;
    font-size: 0.98rem;
    font-weight: 500;
    color: inherit;
    text-decoration: none;
  }
  .site-nav__list a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.2rem;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }
  .site-nav__list a:hover::after {
    transform: scaleX(1);
  }
  .site-nav__lang {
    display: none;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .site-header__lang {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: inherit;
    text-decoration: none;
    border: 1.5px solid currentColor;
    border-radius: var(--radius);
    opacity: 0.85;
    box-sizing: border-box;
  }
  .site-header__lang:hover {
    opacity: 1;
  }
  .site-header__cta {
    min-height: 2.75rem;
    padding: 0 1.15rem;
    font-size: 0.95rem;
  }
  .site-header__toggle {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .toggle-close {
    display: none;
  }

  @media (max-width: 960px) {
    .site-header__actions {
      margin-left: auto;
      margin-right: -0.5rem;
    }
    .site-header__toggle {
      display: grid;
    }
    .site-header__cta,
    .site-header__lang {
      display: none;
    }
    .site-nav {
      position: fixed;
      inset: var(--header-h) 0 auto;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-2);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.25s var(--ease-out),
        transform 0.35s var(--ease-out),
        visibility 0s linear 0.35s;
    }
    :global(.menu-open) .site-nav {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 0.25s var(--ease-out),
        transform 0.35s var(--ease-out);
    }
    :global(.menu-open) .toggle-open {
      display: none;
    }
    :global(.menu-open) .toggle-close {
      display: block;
    }
    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--gutter) 1.5rem;
      color: var(--ink);
    }
    .site-nav__list li {
      border-bottom: 1px solid var(--line);
    }
    .site-nav__list a {
      display: block;
      padding: 1rem 0;
      font-size: 1.15rem;
    }
    .site-nav__list a::after {
      display: none;
    }
    .site-nav__lang {
      display: block;
    }
  }
  /* Without JS the mobile menu cannot open, so show it inline. */
  @media (max-width: 960px) {
    :global(html:not(.js)) .site-nav {
      position: static;
      visibility: visible;
      opacity: 1;
      transform: none;
      box-shadow: none;
    }
  }

  /* ---------- Footer ---------- */
  .site-footer {
    background: var(--dark);
    color: var(--on-dark-muted);
    font-size: 0.98rem;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.1fr 1.5fr;
    gap: 2.5rem;
    padding-block: clamp(3.5rem, 7vw, 5rem) 3rem;
  }
  .site-footer__brand {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    color: var(--on-dark);
  }
  .site-footer__brand p {
    max-width: 30ch;
    color: var(--on-dark-muted);
  }
  .site-footer__title {
    margin-bottom: 1rem;
    color: var(--on-dark);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .site-footer ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer a {
    color: var(--on-dark-muted);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--on-dark);
    text-decoration: underline;
  }
  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--dark-line);
    font-size: 0.9rem;
  }
  @media (max-width: 960px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
