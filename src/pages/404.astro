---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base
  title="Az oldal nem található | Mr. Rock Kft."
  description="A keresett oldal nem található. Térjen vissza a főoldalra."
  noindex
>
  <section class="nf container" aria-labelledby="nf-title">
    <p class="nf__code tnum" aria-hidden="true">
      404
    </p>
    <h1 id="nf-title">Ez az oldal nem található</h1>
    <p>A keresett cím nem létezik, vagy elköltözött.</p>
    <p lang="en">This page does not exist or has moved.</p>
    <a class="btn btn--primary" href="/">
      Vissza a főoldalra <Icon name="arrow" size={18} stroke={2} />
    </a>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding-block: clamp(5rem, 12vw, 9rem);
  }
  .nf__code {
    color: var(--accent);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
  }
  .btn {
    margin-top: 1rem;
  }
</style>
